# Environment Variables Template for Movie Companion App

# LLM API Keys (use uppercase for consistency)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Movie Database APIs
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here
OMDB_API_KEY=your_omdb_api_key_here

# Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here

# Voice/Audio APIs
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# File Paths
PLOTS_PATH=path_to_plots_csv
DESCRIPTION_PATH=path_to_descriptions_pickle
METADATA_PATH=path_to_metadata_cache

# Database Configuration
DATABASE_URL=sqlite:///./app.db

# Authentication
AUTH_SECRET_KEY=your_secret_key_for_jwt_tokens

# API Base URL (for frontend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo Mode (for testing without real APIs)
NEXT_PUBLIC_DEMO=0